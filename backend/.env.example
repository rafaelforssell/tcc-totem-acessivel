# Copie para backend/.env (que esta no .gitignore) e preencha. NUNCA commite o .env.

# IA (Groq): classificacao de intencao, respostas e transcricao de audio
GROQ_API_KEY=

# Telegram Bot (notificacao de atendente)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL (deixar vazio para usar SQLite local)
# DATABASE_URL=postgresql://...

# Painel admin: obrigatorio, sem valor padrao. Use uma senha longa e aleatoria.
ADMIN_KEY=

# Dominios do frontend autorizados (CORS), separados por virgula.
# Opcional: o padrao e https://totem-acessiveltcc.netlify.app (localhost sempre liberado).
# CORS_ORIGINS=https://totem-acessiveltcc.netlify.app

# Tempo (segundos) que os audios ficam no servidor antes de serem apagados
AUDIO_RETENCAO_SEGUNDOS=600
